{
  "name": "clip-twins",
  "version": "0.1.0",
  "description": "Ableton Live Extension: mark identical MIDI clips as the same and near-identical ones as versions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MusicProWorkshop/ableton-clip-twins.git"
  },
  "homepage": "https://github.com/MusicProWorkshop/ableton-clip-twins#readme",
  "bugs": {
    "url": "https://github.com/MusicProWorkshop/ableton-clip-twins/issues"
  },
  "main": "dist/extension.js",
  "engines": {
    "node": ">=22.11.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts --production",
    "build:dev": "tsc --noEmit && tsx build.ts",
    "start": "npm run build:dev && extensions-cli run",
    "package": "npm run build && extensions-cli package -o dist/clip-twins.ablx",
    "test": "tsx test/core.test.ts && tsx test/e2e.ts",
    "preview": "tsx build.ts --ui-only"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:./vendor/ableton-extensions-sdk-1.0.0-beta.1.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:./vendor/ableton-extensions-cli-1.0.0-beta.1.tgz",
    "@types/node": "^24.1.0",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
